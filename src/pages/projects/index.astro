---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import { projects, profile } from '../../data/site';
---
<BaseLayout title={`Projects — ${profile.name}`}>
  <section class="shell intro">
    <p class="eyebrow">projects</p>
    <h1 class="h1">Things I build to understand the hardware beneath the abstraction.</h1>
  </section>
  <section class="shell projects">
    {projects.map((project) => <ProjectCard project={project} />)}
  </section>
</BaseLayout>
<style>
  .intro { padding:72px 0 90px; }
  .intro .eyebrow{margin:0 0 16px}.intro .lede{margin:34px 0 0}.projects{display:grid;gap:96px;padding-bottom:50px}
</style>
