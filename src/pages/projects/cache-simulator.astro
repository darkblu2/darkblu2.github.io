---
import ProjectCaseLayout from '../../components/ProjectCaseLayout.astro';
import CaseStudyTOC from '../../components/CaseStudyTOC.astro';
import { projects } from '../../data/site';

const project = projects.find(
  (project) => project.slug === 'cache-simulator'
);

if (!project) {
  throw new Error('Cache Simulator project not found');
}

const toc = [
  { id: 'overview', label: 'Overview' },
  { id: 'implementation', label: 'Implementation' },
  { id: 'challenge', label: 'The Challenge' },
  { id: 'address-decomposition', label: 'Address Decomposition' },
  { id: 'cache-access', label: 'Cache Access' },
  { id: 'replacement', label: 'Replacement Policy' },
  { id: 'configuration', label: 'Configuration' },
  { id: 'skills', label: 'Engineering Skills' },
];
---
<ProjectCaseLayout
  title={project.title}
  description={project.description}
  number={project.number}
  year={project.year}
  status={project.status}
  tagline={project.tagline}
  image={project.image}
  video={project.video}
  tags={project.tags}
>

  <div slot="sidebar">

    {project.github && (
      <a
        class="text-link"
        href={project.github}
        target="_blank"
        rel="noreferrer"
      >
        GitHub <span>↗</span>
      </a>
    )}

    <CaseStudyTOC items={toc} />

  </div>


  <!-- OVERVIEW -->

  <section id="overview">

    <p class="eyebrow">overview</p>

    <p class="big-copy">
      A configurable cache simulator implemented in C to model how
      memory accesses interact with cache organization, replacement
      policy, and write behavior.
    </p>

    <p>
      The simulator replays memory traces through a cache configured
      by block size, total capacity, and associativity, then reports
      accesses, hits, misses, and dirty-block writebacks.
    </p>

  </section>


  <!-- TECHNICAL CONTRIBUTION -->

  <section id="implementation">

    <p class="eyebrow">implementation</p>

    <h2>
      Modeling cache behavior from address bits to block replacement.
    </h2>

    <div class="contribution-grid">

      <div>
        <span class="num">01</span>
        <h3>Address Mapping</h3>
        <p>
          Calculated cache geometry and extracted tag, index, and
          offset information from physical addresses.
        </p>
      </div>

      <div>
        <span class="num">02</span>
        <h3>Cache Access Logic</h3>
        <p>
          Implemented hit and miss detection using valid bits and
          tag comparisons.
        </p>
      </div>

      <div>
        <span class="num">03</span>
        <h3>LRU Replacement</h3>
        <p>
          Tracked recency within each set and evicted the
          least-recently-used block when a set became full.
        </p>
      </div>

      <div>
        <span class="num">04</span>
        <h3>Writeback Handling</h3>
        <p>
          Managed dirty bits on writes and counted memory writebacks
          when dirty cache blocks were evicted.
        </p>
      </div>

    </div>

  </section>


  <!-- CHALLENGE -->

  <section id="challenge">

    <p class="eyebrow">the challenge</p>

    <h2>
      Turning a memory address into the correct cache operation.
    </h2>

    <p>
      Every memory access required the simulator to determine which
      set the address mapped to, whether the requested block was
      already present, and what should happen if the set was full.
    </p>

    <p>
      Correct behavior depended on several pieces of state working
      together: tag matching, valid and dirty bits, associativity,
      LRU ordering, and the cache's configured block and set sizes.
    </p>

  </section>


  <!-- CACHE ORGANIZATION -->

  <section id="address-decomposition">

    <p class="eyebrow">address decomposition</p>

    <h2>
      Mapping physical addresses into tag, index, and offset fields.
    </h2>

    <p>
      The simulator derives the number of sets from cache capacity,
      block size, and associativity. From those values, it determines
      how many address bits belong to the block offset and set index.
    </p>

    <div class="address-row">

      <div>
        <span>TAG</span>
        <p>Identifies which memory block occupies the selected set.</p>
      </div>

      <div>
        <span>INDEX</span>
        <p>Selects the cache set to inspect.</p>
      </div>

      <div>
        <span>OFFSET</span>
        <p>Selects a byte within the cache block.</p>
      </div>

    </div>

    <p>
      The implementation uses bit shifts and masks to extract the
      index and tag directly from each physical address.
    </p>

  </section>


  <!-- ACCESS FLOW -->

  <section id="cache-access">

    <p class="eyebrow">cache access</p>

    <h2>
      Resolving each memory reference as a hit or miss.
    </h2>

    <div class="flow">

      <div class="flow-box">
        <span>01</span>
        <strong>Read physical address</strong>
      </div>

      <div class="flow-arrow">↓</div>

      <div class="flow-box">
        <span>02</span>
        <strong>Extract set index and tag</strong>
      </div>

      <div class="flow-arrow">↓</div>

      <div class="flow-box">
        <span>03</span>
        <strong>Search valid blocks for matching tag</strong>
      </div>

      <div class="flow-arrow">↓</div>

      <div class="flow-box">
        <span>04</span>
        <strong>Hit → update dirty state and LRU order</strong>
      </div>

      <div class="flow-arrow">or</div>

      <div class="flow-box">
        <span>05</span>
        <strong>Miss → insert block or replace LRU block</strong>
      </div>

      <div class="flow-arrow">↓</div>

      <div class="flow-box">
        <span>06</span>
        <strong>Count writeback if evicted block is dirty</strong>
      </div>

    </div>

  </section>


  <!-- REPLACEMENT -->

  <section id="replacement">

    <p class="eyebrow">replacement policy</p>

    <h2>
      Maintaining LRU state as the cache changes.
    </h2>

    <p>
      On every hit, the accessed block becomes the most recently used.
      On a miss, newly inserted blocks are also marked most recently used.
    </p>

    <p>
      When a set is full, the simulator retrieves the least recently
      used block and replaces it. If that block is dirty, the eviction
      also produces a writeback to memory.
    </p>

    <div class="decision">

      <div>Cache miss</div>
      <span>→</span>
      <div>Set full?</div>
      <span>→</span>
      <div>Find LRU</div>
      <span>→</span>
      <div>Dirty?</div>
      <span>→</span>
      <div>Writeback + replace</div>

    </div>

  </section>


  <!-- CONFIGURATION -->

  <section id="configuration">

    <p class="eyebrow">configuration</p>

    <h2>
      One implementation, multiple cache organizations.
    </h2>

    <p>
      Cache geometry is calculated from parameters supplied at runtime,
      allowing the same simulator to represent different block sizes,
      cache capacities, and associativities.
    </p>

    <div class="parameter-grid">

      <div>
        <p class="eyebrow">block size</p>
        <strong>Controls offset bits</strong>
      </div>

      <div>
        <p class="eyebrow">cache size</p>
        <strong>Controls total storage</strong>
      </div>

      <div>
        <p class="eyebrow">ways</p>
        <strong>Controls associativity</strong>
      </div>

      <div>
        <p class="eyebrow">derived</p>
        <strong>Number of sets</strong>
      </div>

    </div>

  </section>


  <!-- ENGINEERING SKILLS -->

  <section id="skills">

    <p class="eyebrow">engineering skills developed</p>

    <ul class="learning-list">

      <li>
        Translating cache organization into concrete data structures
        and address-manipulation logic.
      </li>

      <li>
        Using bit masking and shifting to extract tag and index fields
        from physical addresses.
      </li>

      <li>
        Implementing set-associative lookup and LRU replacement behavior.
      </li>

      <li>
        Managing valid and dirty state across reads, writes, misses,
        and evictions.
      </li>

      <li>
        Understanding how write-back caches generate memory traffic
        when dirty blocks are replaced.
      </li>

      <li>
        Using dynamic memory allocation and cleanup to represent
        configurable hardware structures in C.
      </li>

      <li>
        Debugging architecture models by comparing simulated hit,
        miss, and writeback counts against expected behavior.
      </li>

    </ul>

  </section>

</ProjectCaseLayout>


<style>

  section {
    padding: 0 0 62px;
    margin: 0 0 62px;

    border-bottom: 1px solid var(--line);
  }

  section:last-child {
    margin-bottom: 0;
    border-bottom: 0;
  }

  section > .eyebrow {
    margin: 0 0 18px;
  }

  section p {
    max-width: 760px;

    color: #3d3e39;

    font-size: 1.08rem;
    line-height: 1.65;
  }

  .big-copy {
    margin-top: 0;

    color: var(--text);

    font-size: clamp(1.35rem, 2.4vw, 1.9rem);
    line-height: 1.4;
  }

  h2 {
    max-width: 780px;

    margin: 0 0 28px;

    font-size: clamp(2rem, 4vw, 4rem);
    line-height: 1.03;
    letter-spacing: -0.045em;

    font-weight: 580;
  }


  /* CONTRIBUTIONS */

  .contribution-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;

    gap: 12px;

    margin-top: 32px;
  }

  .contribution-grid > div {
    padding: 22px;

    background: var(--surface);
    border: 1px solid var(--line);
  }

  .contribution-grid .num {
    display: block;

    margin-bottom: 24px;

    color: var(--muted);
    font-size: 0.72rem;
  }

  .contribution-grid h3 {
    margin: 0 0 10px;

    font-size: 1.15rem;
    font-weight: 580;
  }

  .contribution-grid p {
    margin: 0;

    font-size: 0.92rem;
    line-height: 1.55;
  }


  /* ADDRESS */

  .address-row {
    display: grid;
    grid-template-columns: 1.4fr 1fr 1fr;

    margin: 32px 0;

    border: 1px solid var(--line);
  }

  .address-row > div {
    padding: 20px;

    border-right: 1px solid var(--line);
  }

  .address-row > div:last-child {
    border-right: 0;
  }

  .address-row span {
    color: var(--accent);

    font-size: 0.76rem;
    font-weight: 650;
    letter-spacing: 0.06em;
  }

  .address-row p {
    margin-bottom: 0;

    font-size: 0.9rem;
  }


  /* FLOW */

  .flow {
    max-width: 590px;

    margin-top: 32px;
  }

  .flow-box {
    display: grid;
    grid-template-columns: 50px 1fr;

    gap: 14px;

    padding: 18px 20px;

    background: var(--surface);
    border: 1px solid var(--line);
  }

  .flow-box span {
    color: var(--muted);

    font-size: 0.75rem;
  }

  .flow-arrow {
    padding: 8px 0 8px 23px;

    color: var(--muted);
  }


  /* DECISION */

  .decision {
    display: flex;
    align-items: center;
    flex-wrap: wrap;

    gap: 10px;

    margin-top: 32px;
  }

  .decision div {
    padding: 14px 16px;

    background: var(--surface);
    border: 1px solid var(--line);
  }

  .decision span {
    color: var(--muted);
  }


  /* PARAMETERS */

  .parameter-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;

    gap: 12px;

    margin-top: 32px;
  }

  .parameter-grid > div {
    padding: 22px;

    border: 1px solid var(--line);
  }

  .parameter-grid .eyebrow {
    margin: 0 0 10px;
  }


  /* LEARNING */

  .learning-list {
    padding-left: 1.2em;
  }

  .learning-list li {
    margin-bottom: 14px;

    color: #3d3e39;

    font-size: 1.08rem;
    line-height: 1.6;
  }


  @media (max-width: 760px) {

    .contribution-grid,
    .parameter-grid,
    .address-row {
      grid-template-columns: 1fr;
    }

    .address-row > div {
      border-right: 0;
      border-bottom: 1px solid var(--line);
    }

    .address-row > div:last-child {
      border-bottom: 0;
    }

  }

section {
  scroll-margin-top: 110px;

  padding: 0 0 62px;
  margin: 0 0 62px;

  border-bottom: 1px solid var(--line);
}

</style>