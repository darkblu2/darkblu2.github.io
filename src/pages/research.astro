---
import BaseLayout from '../layouts/BaseLayout.astro';
import { profile, researchNotes } from '../data/site';
---

<BaseLayout title={`Research notebook — ${profile.name}`}>
  <section class="shell intro">
    <p class="eyebrow">research notebook</p>

    <h1 class="h1">
      Papers, questions, and ideas I want to understand well enough to explain.
    </h1>
  </section>

  <section class="shell notes">
    {researchNotes.map((note, i) => (
      <article id={`research-${i + 1}`} class="note-row">
        <div class="note-meta">
          <span>0{i + 1}</span>
          <span>{note.date}</span>
          <span>{note.type}</span>
        </div>

        <div class="note-content">
          <h2>{note.title}</h2>

          <p>{note.thought}</p>

          {(note.caseStudy || note.paper) && (
            <div class="note-links">

              {note.caseStudy && (
                <a
                  class="text-link"
                  href={note.caseStudy.url}
                >
                  {note.caseStudy.title}
                  <span>→</span>
                </a>
              )}

              {note.paper && (
                <a
                  class="text-link"
                  href={note.paper.url}
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  {note.paper.title}
                  <span>↗</span>
                </a>
              )}

            </div>
          )}
        </div>
      </article>
    ))}
  </section>
</BaseLayout>

<style>
  .intro {
    padding: 72px 0 90px;
  }

  .intro .eyebrow {
    margin: 0 0 16px;
  }

  .intro .lede {
    margin: 34px 0 0;
  }

  .notes {
    border-top: 1px solid var(--line);
  }

  .note-row {
    display: grid;
    grid-template-columns: 240px 1fr;
    gap: 50px;
    padding: 32px 0 54px;
    border-bottom: 1px solid var(--line);
  }

  .note-meta {
    display: grid;
    grid-template-columns: 42px 1fr;
    gap: 8px;
    color: var(--muted);
    font-size: 0.78rem;
  }

  .note-meta span:last-child {
    grid-column: 2;
  }

  .note-row h2 {
    font-size: clamp(1.8rem, 3.2vw, 3.6rem);
    line-height: 1.02;
    letter-spacing: -0.045em;
    margin: 0 0 18px;
  }

  .note-row p {
    max-width: 780px;
    color: #41423d;
    font-size: 1.08rem;
  }

  .note-links {
    display: flex;
    flex-wrap: wrap;
    gap: 20px;
    margin-top: 24px;
  }

  .note-links .text-link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }

  @media (max-width: 760px) {
    .note-row {
      grid-template-columns: 1fr;
      gap: 20px;
    }
  }
</style>