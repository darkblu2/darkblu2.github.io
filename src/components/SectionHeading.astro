---
const { eyebrow, title, link, linkLabel = 'View all' } = Astro.props;
---
<div class="section-head">
  <div>
    {eyebrow && <p class="eyebrow">{eyebrow}</p>}
    <h2 class="h2">{title}</h2>
  </div>
  {link && <a class="text-link" href={link}>{linkLabel} <span>↗</span></a>}
</div>
<style>
  .section-head { display:flex; justify-content:space-between; align-items:end; gap:24px; margin-bottom:38px; }
  .section-head .eyebrow { margin:0 0 12px; }
  @media (max-width:760px){.section-head{align-items:flex-start;flex-direction:column;}}
</style>
