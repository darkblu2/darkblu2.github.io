---
import type { Project } from '../data/site';
const {
  project,
  compact = false
} = Astro.props as {
  project: Project;
  compact?: boolean;
};
---
<article id={project.slug} class:list={['project-card', { compact }]}>
  <a class="visual" href={`/projects/${project.slug}`} aria-label={`Read about ${project.title}`}>
    {project.video ? (
    <video
      src={project.video}
      poster={project.image}
      autoplay
      muted
      loop
      playsinline
      preload="metadata"
    />
  ) : (
    <img
      src={project.image}
      alt=""
      loading="lazy"
    />
  )}
  </a>
  <div class="meta-row">
    <span>{project.number}</span><span>{project.year}</span><span>{project.status}</span>
  </div>
  <h3><a href={`/projects/${project.slug}`}>{project.title}</a></h3>
  <p class="tagline">{project.tagline}</p>
  <div class="tags">{project.tags.map((tag) => <span class="pill">{tag}</span>)}</div>
  <a class="text-link" href={`/projects/${project.slug}`}>Case study <span>↗</span></a>
</article>
<style>
  .project-card { border-top:1px solid var(--line); padding-top:18px; }
  .visual { display:block; overflow:hidden; background:var(--surface); aspect-ratio:16/10; margin-bottom:18px; }
  .visual img,
  .visual video {
    width: 100%;
    height: 100%;
    object-fit: cover;

    transition:
      transform .45s cubic-bezier(.2,.8,.2,1),
      filter .3s;
  }

  .visual:hover img,
  .visual:hover video {
    transform: scale(1.025);
    filter: contrast(1.04);
  }
  .meta-row { display:flex; gap:12px; color:var(--accent); text-transform:uppercase; font-size:.7rem; letter-spacing:.08em; }
  h3 { font-size:clamp(1.8rem,3vw,3rem); letter-spacing:-.045em; line-height:1; font-weight:590; margin:14px 0 10px; }
  h3 a:hover { opacity:.58; }
  .tagline { color:#3d3e39; max-width:620px; margin:0 0 18px; }
  .tags { display:flex; flex-wrap:wrap; gap:7px; margin-bottom:20px; }
  .compact h3 { font-size:1.8rem; }
</style>
