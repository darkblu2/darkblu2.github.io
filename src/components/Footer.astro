---
import { profile } from '../data/site';

const year = new Date().getFullYear();
---

<footer class="footer">

  <div class="shell footer-grid">

    <!-- LEFT -->

    <div class="footer-left">

      <p class="eyebrow">
        {profile.role} · {profile.location}
      </p>

      <p class="footer-title">
        Get in touch.
      </p>


      <!-- ICON LINKS -->

      <div class="footer-icons">

        <!-- GitHub -->
        <a
          href={profile.github}
          target="_blank"
          rel="noreferrer"
          aria-label="GitHub"
          title="GitHub"
        >
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <path
              fill="currentColor"
              d="M12 .7C5.7.7.7 5.8.7 12.2c0 5.1 3.3 9.4 7.8 10.9.6.1.8-.3.8-.6v-2.2c-3.2.7-3.9-1.4-3.9-1.4-.5-1.3-1.3-1.7-1.3-1.7-1-.7.1-.7.1-.7 1.2.1 1.8 1.2 1.8 1.2 1 1.8 2.7 1.3 3.4 1 .1-.8.4-1.3.8-1.6-2.6-.3-5.3-1.3-5.3-5.8 0-1.3.5-2.3 1.2-3.1-.1-.3-.5-1.5.1-3.1 0 0 1-.3 3.2 1.2A11 11 0 0 1 12 6.8c1 0 2 .1 2.9.4 2.2-1.5 3.2-1.2 3.2-1.2.6 1.6.2 2.8.1 3.1.8.8 1.2 1.8 1.2 3.1 0 4.5-2.7 5.5-5.3 5.8.4.4.8 1.1.8 2.1v3.1c0 .4.2.7.8.6a11.5 11.5 0 0 0 7.8-10.9C23.3 5.8 18.3.7 12 .7Z"
            />
          </svg>
        </a>


        <!-- LinkedIn -->
        <a
          href={profile.linkedin}
          target="_blank"
          rel="noreferrer"
          aria-label="LinkedIn"
          title="LinkedIn"
        >
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <path
              fill="currentColor"
              d="M5.3 8.1H1.7V22h3.6V8.1ZM3.5 2A2.1 2.1 0 1 0 3.5 6.2 2.1 2.1 0 0 0 3.5 2ZM22.2 13.9c0-4.2-2.3-6.2-5.3-6.2-2.5 0-3.6 1.4-4.2 2.3V8.1H9.1V22h3.6v-6.9c0-1.8.3-3.6 2.6-3.6 2.2 0 2.2 2.1 2.2 3.7V22h3.6l1.1-8.1Z"
            />
          </svg>
        </a>


        <!-- Personal Email -->
        <a
          href={`mailto:${profile.email}`}
          aria-label="Personal Email"
          title="Personal Email"
        >
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <path
              d="M3 5h18v14H3V5Z"
              fill="none"
              stroke="currentColor"
              stroke-width="1.8"
            />

            <path
              d="m3 6 9 7 9-7"
              fill="none"
              stroke="currentColor"
              stroke-width="1.8"
              stroke-linecap="round"
              stroke-linejoin="round"
            />
          </svg>
        </a>


        <!-- Georgia Tech Email -->
        <a
          href={`mailto:${profile.gtemail}`}
          class="gt-icon"
          aria-label="Georgia Tech Email"
          title="Georgia Tech Email"
        >
          <span>GT</span>
        </a>

      </div>

    </div>


    <!-- RIGHT -->

    <div class="footer-links">

      <a
        href={profile.github}
        target="_blank"
        rel="noreferrer"
      >
        GitHub ↗
      </a>

      <a
        href={profile.linkedin}
        target="_blank"
        rel="noreferrer"
      >
        LinkedIn ↗
      </a>

      <a href={`mailto:${profile.email}`}>
        Email ↗
      </a>

      <a href={`mailto:${profile.gtemail}`}>
        Georgia Tech Email ↗
      </a>

    </div>

  </div>


  <!-- BOTTOM -->

  <div class="shell footer-bottom">

    <span>
      © {year} {profile.name}
    </span>

    <span>
      Built with Astro.
    </span>

  </div>

</footer>


<style>

  .footer {
    margin-top: 88px;

    padding: 64px 0 28px;

    border-top: 1px solid var(--line);
  }


  /* MAIN GRID */

  .footer-grid {
    display: grid;
    grid-template-columns: 2fr 1fr;

    gap: 40px;
  }


  /* LEFT */

  .footer-title {
    max-width: 700px;

    margin: 14px 0 0;

    font-size: clamp(1.6rem, 3vw, 3rem);
    line-height: 1.05;
    letter-spacing: -0.04em;
  }


  /* ICONS */

  .footer-icons {
    display: flex;
    align-items: center;

    gap: 10px;

    margin-top: 26px;
  }

  .footer-icons a {
    display: grid;
    place-items: center;

    width: 28px;
    height: 28px;

    border: 1px solid var(--line);
    border-radius: 50%;

    color: var(--accent);

    transition:
      color 0.2s ease,
      background 0.2s ease,
      border-color 0.2s ease,
      transform 0.2s ease;
  }

  .footer-icons svg {
    width: 17px;
    height: 17px;
  }

  .footer-icons a:hover {
    color: var(--bg);

    background: var(--text);
    border-color: var(--text);

    transform: translateY(-2px);
  }


  /* GT ICON */

  .gt-icon span {
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: -0.03em;
  }


  /* RIGHT LINKS */

  .footer-links {
    display: flex;
    flex-direction: column;
    align-items: flex-end;

    gap: 10px;
  }

  .footer-links a {
    transition: opacity 0.2s ease;
  }

  .footer-links a:hover {
    opacity: 0.55;
  }


  /* BOTTOM */

  .footer-bottom {
    display: flex;
    justify-content: space-between;

    margin-top: 70px;
    padding-top: 18px;

    border-top: 1px solid var(--line);

    color: var(--muted);

    font-size: 0.8rem;
  }


  /* MOBILE */

  @media (max-width: 760px) {

    .footer-grid {
      grid-template-columns: 1fr;
    }

    .footer-links {
      align-items: flex-start;
    }

    .footer-bottom {
      flex-direction: column;

      gap: 16px;
    }

  }

</style>